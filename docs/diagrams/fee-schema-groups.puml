@startuml
' Nhóm bảng phí cứu hộ — cập nhật 2026-09-23
' Không fee_surcharge_rule_service; hiệu lực ở fee_table_version
skinparam packageStyle rectangle

package "Catalog" {
  rectangle fee_criterion_def as CritDef
  rectangle fee_criterion_mapping_field as CritMap
  rectangle service as Svc
  rectangle incidental_fee_def as Incidental
}

package "Cau_hinh_bang_phi" {
  rectangle fee_table as FT
  rectangle fee_table_version as FTV
  rectangle fee_table_scope as Scope
  rectangle fee_table_settings as Settings
  rectangle fee_price_line as PL
  rectangle fee_price_line_condition as PLC
  rectangle fee_surcharge_rule as SR
  rectangle fee_surcharge_condition as SRC
}

package "Tren_don" {
  rectangle ro_fee_snapshot as Snap
  rectangle ro_fee_line as Line
  rectangle ro_fee_adj as Adj
}

CritDef --> CritMap : table/field map
CritDef --> PLC
CritDef --> SRC
FT --> FTV
FTV --> Scope
FTV --> Settings
FTV --> PL : segment_type\n(no line valid_*)
FTV --> SR : ALL services
PL --> PLC
SR --> SRC
FT --> Snap
Snap --> Line
Line --> Adj
Svc --> PL

note right of CritMap
  Map criterion_key →
  order | line | vehicle
end note

note bottom of FTV
  valid_from / valid_to
  = hiệu lực phiên bản bảng
end note

note bottom of SR
  Không M:N dịch vụ
  (ALL trên bảng)
end note

@enduml
